{
  "name": "C++ Cross-Platform Dev Environment",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "cmake.configureOnOpen": true
      },
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "remoteUser": "developer"
}